{
  "name": "@lernapps/site",
  "private": true,
  "type": "module",
  "description": "Home page of lernapps.net, and the site frame shared by all its sites (design tokens, header, footer, checks)",
  "exports": {
    "./frame": "./site-frame/frame.js",
    "./nav": "./site-frame/nav.js",
    "./eleventy": "./site-frame/eleventy.js",
    "./tokens.css": "./site-frame/tokens.css",
    "./frame.css": "./site-frame/frame.css"
  },
  "bin": {
    "lernapps-frame": "site-frame/inject.mjs",
    "site-check": "site-frame/check.mjs",
    "lernapps-check": "site-frame/check.mjs"
  },
  "files": [
    "site-frame/"
  ],
  "scripts": {
    "dev": "npm run build && (eleventy --serve --quiet & unocss \"_site/**/*.html\" --out-file _site/uno.css --watch; wait)",
    "build": "eleventy && unocss \"_site/**/*.html\" --out-file _site/uno.css --minify",
    "check": "node site-frame/check.mjs --site / --forbid TODO-EMAIL",
    "test": "node --test \"test/**/*.test.mjs\"",
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks || true"
  },
  "devDependencies": {
    "@11ty/eleventy": "3.1.7",
    "@unocss/cli": "66.11.0",
    "@unocss/preset-typography": "66.11.0",
    "@unocss/preset-wind4": "66.11.0"
  },
  "license": "MIT"
}
