---
pagination:
  data: languages
  size: 1
  alias: l
permalink: "{{ l.root }}features/index.html"
---
{#-
  "Features" in the header: what lernapps is made of, in three parts. For users (what the apps can do), for
  developers (what you get when you build: foundations or your own stack, guidance for the AI assistant, how an app
  is listed, ownership and licence) and the platform (what makes it unique, with the principles and the link to the
  docs). The home page links its anchors (de: #nutzer, #plattform, #kosten, #prinzipien; en: #users, #platform,
  #costs, #principles). Texts: features in src/_data/de.js, en.js.
-#}
{%- set F = l.t.features -%}
<!doctype html>
<html lang="{{ l.code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="referrer" content="strict-origin-when-cross-origin">
  <title>{{ F.meta.title }}</title>
  <meta name="description" content="{{ F.meta.description }}">
  <link rel="canonical" href="https://lernapps.net/{{ l.root }}features/">
  {%- if site.preview %}
  <meta name="robots" content="noindex">
  {%- endif %}
  {% laHead page.url %}
  <link rel="stylesheet" href="{{ '/uno.css' | own }}">
</head>
<body>
  <div class="min-h-screen bg-slate-900 text-white" style="font-family: system-ui, -apple-system, 'Segoe UI', sans-serif;">
  {% laHeader page.url %}

  <main id="main-content" tabindex="-1" class="outline-none">

    {# ══════ HERO ══════ #}
    <section class="relative overflow-hidden">
      <div class="absolute inset-0 pointer-events-none" style="background-image: linear-gradient(rgba(255,255,255,.03) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.03) 1px, transparent 1px); background-size: 48px 48px;" aria-hidden="true"></div>
      <div class="relative max-w-4xl mx-auto px-6 py-20 sm:py-24 w-full">
        <h1 class="font-extrabold leading-none tracking-tight text-white mb-6" style="font-size: clamp(2rem, 6vw, 3.5rem);">{{ F.hero.headline }}</h1>
        <p class="text-slate-300 mb-8 max-w-2xl" style="font-size: clamp(1.0625rem, 2vw, 1.25rem); line-height: 1.5;">{{ F.hero.subtitle }}</p>
        <ul class="flex flex-wrap gap-2 list-none p-0 m-0">
          {%- for j in F.hero.jump %}
          <li><a href="{{ j.href }}" class="inline-flex items-center gap-2 px-4 py-2 rounded-full text-sm font-medium bg-slate-800 text-slate-200 border border-slate-700 hover:border-blue-500 hover:text-white transition-colors">{{ j.label }} ↓</a></li>
          {%- endfor %}
        </ul>
      </div>
    </section>

    {# ══════ FOR USERS ══════ #}
    {%- set U = F.users %}
    <section id="{{ U.id }}" class="bg-white py-16 sm:py-20 scroll-mt-16" aria-labelledby="users-heading">
      <div class="max-w-5xl mx-auto px-6">
        <p class="text-xs font-semibold text-blue-600 uppercase tracking-wider mb-3">{{ U.kicker }}</p>
        <h2 id="users-heading" class="font-extrabold tracking-tight text-slate-900 mb-4" style="font-size: clamp(1.75rem, 4.5vw, 2.5rem); line-height: 1.15;">{{ U.heading }}</h2>
        <p class="text-slate-700 leading-relaxed max-w-3xl mb-10" style="font-size: 1.0625rem;">{{ U.intro }}</p>
        <ul class="grid grid-cols-1 md:grid-cols-3 gap-5 list-none p-0 m-0 mb-12">
          {%- for t in U.archetypes %}
          <li class="rounded-2xl border border-blue-200 bg-blue-50 p-6">
            <span class="text-3xl" aria-hidden="true">{{ t.icon }}</span>
            <h3 class="font-bold text-slate-900 text-lg mt-3 mb-2">{{ t.title }}</h3>
            <p class="text-sm text-slate-700 leading-relaxed">{{ t.text }}</p>
            {%- if t.extra %}
            <p class="mt-3 text-sm text-slate-700 leading-relaxed"><span aria-hidden="true">✨</span> {{ t.extra }}</p>
            {%- endif %}
          </li>
          {%- endfor %}
        </ul>
        <ul class="grid grid-cols-1 sm:grid-cols-2 gap-x-10 gap-y-6 list-none p-0 m-0">
          {%- for it in U.items %}
          <li class="flex gap-3">
            <span class="text-blue-600 font-bold mt-0.5" aria-hidden="true">✓</span>
            <div><h3 class="font-semibold text-slate-900 mb-1">{{ it.title }}</h3><p class="text-slate-600 leading-relaxed">{{ it.text }}</p></div>
          </li>
          {%- endfor %}
        </ul>
        <a href="{{ U.ctaHref | own }}" class="mt-10 inline-flex items-center gap-2 px-6 py-3 bg-blue-600 hover:bg-blue-700 text-white font-semibold rounded-xl transition-colors">{{ U.cta }} →</a>
      </div>
    </section>

    {# ══════ FOR DEVELOPERS ══════ #}
    {%- set D = F.developers %}
    <section id="{{ D.id }}" class="bg-slate-800 py-16 sm:py-20 scroll-mt-16" aria-labelledby="developers-heading">
      <div class="max-w-4xl mx-auto px-6">
        <p class="text-xs font-semibold text-blue-300 uppercase tracking-wider mb-3">{{ D.kicker }}</p>
        <h2 id="developers-heading" class="font-extrabold tracking-tight text-white mb-6" style="font-size: clamp(1.75rem, 4.5vw, 3rem); line-height: 1.15;">{{ D.heading }}</h2>
        <p class="text-slate-300 leading-relaxed max-w-3xl mb-12" style="font-size: 1.0625rem;">{{ D.intro }}</p>
        <div class="space-y-6">
          {%- for b in D.blocks %}
          <div id="{{ b.id }}" class="rounded-2xl border border-slate-700 bg-slate-900 p-6 sm:p-8 scroll-mt-16">
            <h3 class="text-lg font-semibold text-white mb-4">{{ b.title }}</h3>
            {%- if b.text %}
            <div class="space-y-3">
              {%- for p in b.text | paragraphs %}
              <p class="text-slate-300 leading-relaxed">{{ p }}</p>
              {%- endfor %}
            </div>
            {%- endif %}
            {%- if b.steps %}
            <ol class="space-y-4 list-none p-0 m-0">
              {%- for st in b.steps %}
              <li class="flex gap-4">
                <span class="shrink-0 w-8 h-8 rounded-full bg-blue-600 text-white flex items-center justify-center text-sm font-bold" aria-hidden="true">{{ loop.index }}</span>
                <p class="text-slate-300 leading-relaxed pt-1">{{ st }}</p>
              </li>
              {%- endfor %}
            </ol>
            {%- endif %}
          </div>
          {%- endfor %}
        </div>
        <ul class="flex flex-wrap gap-3 list-none p-0 m-0 mt-10">
          {%- for link in D.links %}
          <li><a href="{{ link.href | own }}" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl border border-slate-600 text-white text-sm font-semibold hover:border-blue-400 hover:text-blue-200 transition-colors">{{ link.label }} →</a></li>
          {%- endfor %}
        </ul>
        <p class="mt-4 text-sm text-slate-400">{{ D.note }}</p>
        <a href="{{ D.ctaHref | own }}" class="mt-10 inline-flex items-center gap-2 px-6 py-3 bg-blue-600 hover:bg-blue-500 text-white font-semibold rounded-xl transition-colors">{{ D.cta }} →</a>
      </div>
    </section>

    {# ══════ THE PLATFORM — what makes it unique, and its principles ══════ #}
    {%- set P = F.platform %}
    <section id="{{ P.id }}" class="bg-white py-16 sm:py-20 scroll-mt-16" aria-labelledby="platform-heading">
      <div class="max-w-5xl mx-auto px-6">
        <p class="text-xs font-semibold text-blue-600 uppercase tracking-wider mb-3">{{ P.kicker }}</p>
        <h2 id="platform-heading" class="font-extrabold tracking-tight text-slate-900 mb-4" style="font-size: clamp(1.75rem, 4.5vw, 2.5rem); line-height: 1.15;">{{ P.heading }}</h2>
        <p class="text-slate-700 leading-relaxed max-w-3xl mb-10" style="font-size: 1.0625rem;">{{ P.intro }}</p>
        <ul class="grid grid-cols-1 md:grid-cols-2 gap-5 list-none p-0 m-0">
          {%- for u in P.unique %}
          <li id="{{ u.id }}" class="flex gap-4 rounded-2xl border border-slate-200 p-6 scroll-mt-16">
            <span class="text-3xl" aria-hidden="true">{{ u.icon }}</span>
            <div><h3 class="font-bold text-slate-900 text-lg mb-2">{{ u.title }}</h3><p class="text-slate-600 leading-relaxed">{{ u.text }}{% if u.link %} <a href="{{ u.link.href | own }}" class="font-semibold text-blue-700 underline underline-offset-2 hover:text-blue-800 whitespace-nowrap">{{ u.link.label }} →</a>{% endif %}</p></div>
          </li>
          {%- endfor %}
        </ul>

        {%- set R = P.principles %}
        <div id="{{ R.id }}" class="mt-16 rounded-3xl bg-slate-50 border border-slate-200 p-6 sm:p-10 scroll-mt-16">
          <h3 class="font-extrabold tracking-tight text-slate-900 mb-3" style="font-size: clamp(1.5rem, 3.5vw, 2rem); line-height: 1.2;">{{ R.heading }}</h3>
          <p class="text-slate-700 leading-relaxed max-w-3xl mb-8">{{ R.intro }}</p>
          <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 list-none p-0 m-0">
            {%- for it in R.items %}
            <li class="bg-white rounded-2xl border border-slate-200 p-6">
              <span class="text-2xl" aria-hidden="true">{{ it.icon }}</span>
              <h4 class="text-base font-semibold text-slate-900 mt-3 mb-2">{{ it.title }}</h4>
              <p class="text-sm text-slate-600 leading-relaxed">{{ it.text }}</p>
            </li>
            {%- endfor %}
          </ul>
        </div>

        <ul class="flex flex-wrap gap-3 list-none p-0 m-0 mt-10">
          {%- for link in P.links %}
          <li><a href="{{ link.href | own }}" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl border border-slate-300 text-slate-800 text-sm font-semibold hover:border-blue-400 hover:text-blue-700 transition-colors">{{ link.label }} →</a></li>
          {%- endfor %}
        </ul>
      </div>
    </section>
  </main>

  {% laFooter page.url %}
  </div>
</body>
</html>
