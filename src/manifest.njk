---
pagination: { data: apps, size: 1, alias: app }
permalink: "{{ app.pfad }}/manifest.webmanifest"
eleventyExcludeFromCollections: true
---
{
  "name": {{ app.titel | dump | safe }},
  "short_name": {{ (app.kurzname or app.titel) | dump | safe }},
  "description": {{ app.beschreibung | dump | safe }},
  "lang": "de",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "background_color": "#ffffff",
  "theme_color": "{{ app.farbe.primaer }}",
  "icons": [
    { "src": "favicon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" },
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png" }
  ]
}
