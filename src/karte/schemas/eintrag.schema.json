{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lernapps.github.io/karte/schemas/eintrag.schema.json",
  "title": "Eintrag",
  "description": "Ein Eintrag in data.json (eintraege[]): eine App, die Knoten der Karte übt (edugo-kompatibel). Quelle: APP.kartenEintrag plus kartenKnoten der Kompetenzen in src/<app>/js/app.config.js, oder ein Objekt in src/karte/daten/externe-eintraege.js (dort optional pfad).",
  "type": "object",
  "required": [
    "id",
    "titel",
    "url",
    "quellcode",
    "kompetenzen",
    "aktiv-level",
    "backend",
    "external-requests",
    "dsgvo",
    "evidence",
    "jahrgaenge",
    "lizenz",
    "stand"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "titel": {
      "type": "string",
      "minLength": 1
    },
    "url": {
      "type": "string",
      "format": "uri"
    },
    "quellcode": {
      "type": "string"
    },
    "kompetenzen": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "aktiv-level": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5,
      "description": "1 Create, 2 Solve, 3 Collaborate, 4 Reflect, 5 Receive (edugo active/passive taxonomy)"
    },
    "backend": {
      "type": "string",
      "enum": [
        "none",
        "optional",
        "required"
      ]
    },
    "external-requests": {
      "type": "string",
      "enum": [
        "none",
        "on-consent",
        "always"
      ]
    },
    "dsgvo": {
      "type": "string",
      "enum": [
        "green",
        "amber",
        "red",
        "unknown"
      ],
      "description": "green nur mit backend none, external-requests none und Prüfung"
    },
    "evidence": {
      "type": "string",
      "enum": [
        "anecdotal",
        "community-validated",
        "research-backed"
      ]
    },
    "jahrgaenge": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 5,
        "maximum": 10
      }
    },
    "lizenz": {
      "type": "string"
    },
    "stand": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "beschreibung": {
      "type": "string"
    },
    "pfad": {
      "type": "string",
      "description": "nur externe-eintraege.js: Ordner der App im Monorepo, sobald sie migriert ist"
    }
  }
}
