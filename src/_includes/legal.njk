{#-
  Layout for the legal pages (/privacy/, /imprint/). Each page carries both languages: German first
  (binding), then English. Front matter: title (both languages), description, and the body with a
  <section lang="de" id="de"> and a <section lang="en" id="en">.
  Contact data comes from src/_data/legal.js.
-#}
<!doctype html>
<html lang="de">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="referrer" content="strict-origin-when-cross-origin">
  <title>{{ title }} · lernapps.net</title>
  <meta name="description" content="{{ description }}">
  <link rel="icon" href="/favicon.ico" sizes="32x32">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <link rel="stylesheet" href="/uno.css">
</head>
<body class="bg-white text-slate-800" style="font-family: system-ui, -apple-system, 'Segoe UI', sans-serif;">
  <header class="bg-slate-900 text-white">
    <div class="max-w-3xl mx-auto px-6 py-4 flex flex-wrap items-center justify-between gap-4">
      <a href="/" class="flex items-end gap-[14px] leading-none font-semibold tracking-tight"><img src="/brand/mark-plain.svg" alt="" style="height: 1.25em; margin-bottom: -.12em;"><span>lernapps<span class="text-blue-400">.net</span></span></a>
      <nav aria-label="Sprache / Language">
        <ul class="flex gap-4 list-none p-0 m-0 text-sm">
          <li><a href="#de" hreflang="de" class="text-slate-300 hover:text-white">Deutsch</a></li>
          <li><a href="#en" hreflang="en" lang="en" class="text-slate-300 hover:text-white">English</a></li>
        </ul>
      </nav>
    </div>
  </header>

  <main id="main-content" class="max-w-3xl mx-auto px-6 py-12 prose prose-slate">
    {{ content | safe }}
  </main>

  <footer class="bg-slate-900 text-slate-400 py-8">
    <nav class="max-w-3xl mx-auto px-6" aria-label="Rechtliches / Legal">
      <ul class="flex flex-wrap gap-4 list-none p-0 m-0 text-xs">
        <li><a href="/" class="hover:text-white">Startseite / Home</a></li>
        <li><a href="/privacy/" class="hover:text-white">Datenschutz / Privacy</a></li>
        <li><a href="/imprint/" class="hover:text-white">Impressum / Imprint</a></li>
      </ul>
    </nav>
  </footer>
</body>
</html>
