{#-
  Layout for the legal pages (/privacy/, /imprint/). Each page carries both languages: German first
  (binding), then English. Front matter: title (both languages), description, and the body with a
  <section lang="de" id="de"> and a <section lang="en" id="en">.
  Contact data comes from src/_data/legal.js.
-#}
<!doctype html>
<html lang="de">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="referrer" content="strict-origin-when-cross-origin">
  <title>{{ title }} · lernapps.net</title>
  <meta name="description" content="{{ description }}">
  {%- if site.preview %}
  <meta name="robots" content="noindex">
  {%- endif %}
  {% laHead %}
  <link rel="stylesheet" href="{{ '/uno.css' | own }}">
</head>
<body class="bg-white text-slate-800" style="font-family: system-ui, -apple-system, 'Segoe UI', sans-serif;">
  {% laHeader page.url %}
  <nav aria-label="Sprache / Language" class="max-w-3xl mx-auto px-6 pt-6">
    <ul class="flex gap-4 list-none p-0 m-0 text-sm">
      <li><a href="#de" hreflang="de" class="text-blue-700 underline">Deutsch</a></li>
      <li><a href="#en" hreflang="en" lang="en" class="text-blue-700 underline">English</a></li>
    </ul>
  </nav>

  <main id="main-content" tabindex="-1" class="max-w-3xl mx-auto px-6 py-8 prose prose-slate outline-none">
    {{ content | safe }}
  </main>

  {% laFooter %}
</body>
</html>
