---
layout: basis.njk
---
{#- Kompetenzseite: Warum, Regel, Beispiel, Bild, Video, serlo-Link (optional), Übung – Inhalte aus dem Front Matter von src/<app>/<id>.md.
    Ohne eigenes Video: videoVerweis (ein Satz mit Link auf das Video einer verwandten Seite) oder gar kein Abschnitt #video. -#}
{%- set k = kompetenzDaten -%}
    <h1>{{ k.titel }}</h1>

    <details id="erklaerung" class="erklaerung" open>
      <summary>Erklärung: Warum, Regel, Beispiel, Bild, Video</summary>
    <section id="warum">
      <h2>Warum das wichtig ist</h2>
{{ warum | renderContent("md") | safe }}
    </section>

    <section id="regel">
      <h2>Die Regel</h2>
{{ regel | renderContent("md") | safe }}
    </section>

    <section id="beispiel">
      <h2>Beispiel</h2>
{{ beispiel | renderContent("md") | safe }}
    </section>

{% if bild %}
    <section id="visualisierung">
      <h2>Bild dazu</h2>
      <p class="vis-beschriftung">{{ bild.text }}</p>
      {% bild app.pfad, k, bild %}
    </section>
{% endif %}
{% if video %}
    <section id="video" class="video-karte" data-youtube-id="{{ video.id }}" data-titel="{{ video.titel }}" data-kanal="{{ video.kanal }}">
      <h2>Video dazu</h2>
{% if video.hinweis %}      <p class="video-notiz">{{ video.hinweis }}</p>
{% endif %}      <p><a href="https://www.youtube.com/watch?v={{ video.id }}" rel="noopener">{{ video.titel }}</a></p>
      <p class="video-kanal">{{ video.kanal }} · YouTube</p>
      <p class="video-hinweis">Beim Start werden Daten (u. a. deine IP-Adresse) an YouTube/Google übertragen.</p>
    </section>
{% elif videoVerweis %}
    <section id="video">
      <h2>Video dazu</h2>
      <p>{{ videoVerweis | safe }}</p>
    </section>
{% endif %}
{% if serlo %}
    <section id="serlo" class="serlo-link">
      <p>Noch eine Erklärung: <a href="{{ serlo.url }}" rel="noopener">{{ serlo.titel }}</a> bei serlo.org</p>
    </section>
{% endif %}
    </details>

    <section id="uebung">
      <h2>Übung</h2>
      <noscript><p>Für die Übungsaufgaben brauchst du JavaScript. Die Erklärung, das Beispiel und das Bild oben funktionieren auch ohne.</p></noscript>
      <div class="trainer" id="trainer"></div>
    </section>
  <script type="module">
    import { APP } from "./js/app.config.js";
    import { starteSeite } from "../kern/js/seite.js";
    import * as modul from "./{{ k.modulPfad }}";
    const kompetenz = { nr: {{ k.nr }}, titel: {{ k.titel | dump | safe }} };
{%- if bild %}
    import { {{ bild.uebungFunktion or bild.funktion }} } from "./js/vis/{{ bild.modul or k.id }}.js";
    starteSeite({ app: APP, modul, zeichne: {{ bild.uebungFunktion or bild.funktion }}, bildHinweis: {{ (bild.uebung or "") | dump | safe }}, kompetenz });
{%- else %}
    starteSeite({ app: APP, modul, kompetenz });
{%- endif %}
  </script>
{%- if seitenSkript %}
  <script type="module" src="{{ seitenSkript }}"></script>
{%- endif %}
