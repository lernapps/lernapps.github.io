{#- The way a result takes: the app, one click, the learner's own assistant. Needs K (landing.ki). Text only, no image: it
    reads the same with a screen reader and without styles. -#}
<div role="group" aria-label="{{ K.flow.label }}">
  <ol class="grid grid-cols-1 sm:grid-cols-2 gap-3 list-none p-0 m-0">
    {%- for s in K.flow.steps %}
    <li class="flex items-center gap-3 rounded-xl border border-slate-200 bg-white p-4">
      <span class="shrink-0 w-8 h-8 rounded-full bg-blue-600 text-white flex items-center justify-center text-sm font-bold" aria-hidden="true">{{ loop.index }}</span>
      <span class="text-sm text-slate-700 leading-snug">{{ s }}</span>
    </li>
    {%- endfor %}
  </ol>
  <p class="mt-3 flex items-center gap-2 rounded-xl border border-dashed border-slate-300 px-4 py-3 text-sm text-slate-700"><span aria-hidden="true">🚫</span>{{ K.flow.noServer }}</p>
</div>
