---
pagination:
  data: languages
  size: 1
  alias: l
permalink: "{{ l.root }}join/index.html"
---
{#-
  "Mitmachen" in the header: one block per persona (teachers, parents, learners, makers, the platform itself), each
  with what they can do, where to go and a prompt for their AI assistant. The prompt is plain text in a <pre>,
  readable without JS; join.js adds the copy button. Texts: join in src/_data/de.js, en.js.
-#}
{%- set J = l.t.join -%}
<!doctype html>
<html lang="{{ l.code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="referrer" content="strict-origin-when-cross-origin">
  <title>{{ J.meta.title }}</title>
  <meta name="description" content="{{ J.meta.description }}">
  <link rel="canonical" href="https://lernapps.net/{{ l.root }}join/">
  {%- if site.preview %}
  <meta name="robots" content="noindex">
  {%- endif %}
  {% laHead page.url %}
  {%- include "counter.njk" %}
  <link rel="stylesheet" href="{{ '/uno.css' | own }}">
  <script src="{{ '/join.js' | own }}" defer></script>
</head>
<body>
  <div class="min-h-screen bg-slate-900 text-white" style="font-family: system-ui, -apple-system, 'Segoe UI', sans-serif;">
  {% laHeader page.url %}

  <main id="main-content" tabindex="-1" class="outline-none">

    {# ══════ HERO ══════ #}
    <section class="relative overflow-hidden">
      <div class="absolute inset-0 pointer-events-none" style="background-image: linear-gradient(rgba(255,255,255,.03) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.03) 1px, transparent 1px); background-size: 48px 48px;" aria-hidden="true"></div>
      <div class="relative max-w-4xl mx-auto px-6 py-20 sm:py-24 w-full">
        <h1 class="font-extrabold leading-none tracking-tight text-white mb-6" style="font-size: clamp(2rem, 6vw, 3.5rem);">{{ J.hero.headline }}</h1>
        <p class="text-slate-300 mb-8 max-w-2xl" style="font-size: clamp(1.0625rem, 2vw, 1.25rem); line-height: 1.5;">{{ J.hero.subtitle }}</p>
        <ul class="flex flex-wrap gap-2 list-none p-0 m-0">
          {%- for p in J.personas %}
          <li><a href="#{{ p.id }}" class="inline-flex items-center gap-2 px-4 py-2 rounded-full text-sm font-medium bg-slate-800 text-slate-200 border border-slate-700 hover:border-blue-500 hover:text-white transition-colors"><span aria-hidden="true">{{ p.icon }}</span>{{ p.role }}</a></li>
          {%- endfor %}
        </ul>
      </div>
    </section>

    {# ══════ PERSONAS ══════ #}
    <div class="bg-slate-50 py-16 sm:py-20">
      <div class="max-w-4xl mx-auto px-6 space-y-8">
        {%- for p in J.personas %}
        <section id="{{ p.id }}" class="bg-white rounded-2xl border border-slate-200 p-6 sm:p-10 scroll-mt-16" aria-labelledby="{{ p.id }}-heading">
          <div class="flex items-center gap-4 mb-5">
            <span class="text-4xl" aria-hidden="true">{{ p.icon }}</span>
            <div>
              <p class="text-xs font-semibold text-blue-600 uppercase tracking-wider mb-1">{{ p.role }}</p>
              <h2 id="{{ p.id }}-heading" class="font-bold text-slate-900 leading-snug" style="font-size: clamp(1.25rem, 3vw, 1.75rem);">{{ p.headline }}</h2>
            </div>
          </div>
          <p class="text-slate-600 leading-relaxed" style="font-size: 1.0625rem;">{{ p.text }}</p>
          <div class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-3">
            <a href="{{ p.ctaHref | own }}" class="inline-flex items-center gap-2 px-6 py-3 bg-blue-600 hover:bg-blue-700 text-white font-semibold rounded-xl transition-colors text-sm">{{ p.cta }} →</a>
            {%- if p.secondary %}
            <a href="{{ p.secondaryHref | own }}" class="font-semibold text-blue-700 underline underline-offset-2 hover:text-blue-800 text-sm">{{ p.secondary }}</a>
            {%- endif %}
          </div>
          <div class="mt-8 rounded-xl border border-slate-200 bg-slate-50 p-5" data-ask>
            <h3 class="text-sm font-semibold text-slate-900 mb-1"><span aria-hidden="true">✨</span> {{ J.askBox.title }}</h3>
            <p class="text-sm text-slate-600 leading-relaxed mb-3">{{ J.askBox.intro }}</p>
            <pre class="m-0 whitespace-pre-wrap break-words rounded-lg bg-white border border-slate-200 p-4 text-sm text-slate-800 leading-relaxed" style="font-family: inherit;" data-ask-text>{{ p.ask }}</pre>
            <button type="button" hidden data-ask-copy data-copied="{{ J.askBox.copied }}" class="mt-3 inline-flex items-center gap-2 px-4 py-2 rounded-lg border border-slate-300 bg-white text-sm font-semibold text-slate-700 hover:border-blue-400 hover:text-blue-700 transition-colors">{{ J.askBox.copy }}</button>
          </div>
        </section>
        {%- endfor %}
      </div>
    </div>
  </main>

  {% laFooter page.url %}
  </div>
</body>
</html>
