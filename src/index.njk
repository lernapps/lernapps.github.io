---
permalink: /index.html
---
{#-
  Home page of lernapps.net, in the look of the former edugo landing page; CSS is generated by UnoCSS at
  build time (uno.config.js). The story follows the platform design: problems, portraits per persona,
  principles, why it is free (with a personal word), and an honest answer for sceptics.

  Without JS every persona's problem quote and solution card is shown, stacked, each with its role.
  start.js turns them into the tabs of the original (tablist/tab/tabpanel, arrow keys, auto-advance).
  Hooks for start.js are data-* attributes; the tab classes live in data-active/data-inactive so that
  UnoCSS sees them in the HTML.

  Texts: src/_data/de.js. No copy in this file.
-#}
{%- set L = de.landing -%}
<!doctype html>
<html lang="de">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="referrer" content="strict-origin-when-cross-origin">
  <title>{{ de.meta.title }}</title>
  <meta name="description" content="{{ de.meta.description }}">
  <link rel="canonical" href="https://lernapps.net/">
  {%- if site.preview %}
  <meta name="robots" content="noindex">
  {%- endif %}
  <link rel="icon" href="{{ '/favicon.ico' | own }}" sizes="32x32">
  <link rel="icon" href="{{ '/favicon.svg' | own }}" type="image/svg+xml">
  <link rel="apple-touch-icon" href="{{ '/apple-touch-icon.png' | own }}">
  <link rel="stylesheet" href="uno.css">
  <link rel="stylesheet" href="start.css">
  <script src="start.js" defer></script>
</head>
<body>
  {%- if site.preview %}
  <p class="m-0 px-4 py-2 text-center text-sm bg-amber-300 text-slate-900">{{ de.meta.preview }} <a href="https://lernapps.net/" class="underline">lernapps.net</a></p>
  {%- endif %}
  <a href="#main-content" class="sr-only focus:not-sr-only focus:!fixed focus:top-2 focus:left-2 focus:z-50 focus:!px-4 focus:!py-2 focus:bg-white focus:text-blue-700 focus:font-semibold focus:rounded focus:shadow">{{ de.meta.skipLink }}</a>

  <div class="min-h-screen bg-slate-900 text-white" style="font-family: system-ui, -apple-system, 'Segoe UI', sans-serif;">
  {# ══════ TOP NAV ══════ #}
  <header class="sticky top-0 z-40 bg-slate-900/90 backdrop-blur border-b border-white/5">
    <div class="max-w-4xl mx-auto px-6 flex items-center justify-between gap-x-8">
      <a href="{{ '/' | own }}" aria-label="{{ L.nav.homeLabel }}" aria-current="page" class="flex items-end gap-[14px] py-4 leading-none text-white font-semibold tracking-tight" style="font-size: 1.125rem;">
        <img src="{{ '/brand/mark-plain.svg' | own }}" alt="" style="height: 1.25em; margin-bottom: -.12em;"><span>lernapps<span class="text-blue-400">.net</span></span>
      </a>
      {%- macro navLinks(cls) %}
          {%- for link in L.nav.links %}
          {%- set external = link.href.startsWith("http") %}
          <li><a href="{{ link.href | own }}" class="{{ cls }} text-slate-300 hover:text-white transition-colors"{% if external %} target="_blank" rel="noopener noreferrer"{% endif %}>{{ link.label }}</a></li>
          {%- endfor %}
      {%- endmacro %}
      <nav aria-label="{{ L.nav.ariaLabel }}">
        <ul class="max-md:hidden flex gap-6 list-none p-0 m-0 text-sm whitespace-nowrap">
          {{- navLinks("") }}
        </ul>
        {# Mobile: burger as <details>, works without JS; start.js adds Escape and outside click. #}
        <details class="md:hidden" data-menu>
          <summary class="flex items-center justify-center w-11 h-11 -mr-3 cursor-pointer text-slate-200 hover:text-white rounded-lg focus-visible:outline-2 focus-visible:outline-blue-400" aria-label="{{ L.nav.menuLabel }}">
            <svg data-icon="open" width="24" height="24" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
            <svg data-icon="close" width="24" height="24" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
          </summary>
          <ul class="absolute inset-x-0 top-full list-none m-0 px-6 py-2 bg-slate-900 border-b border-white/10 shadow-xl">
            {{- navLinks("block py-3 text-base") }}
          </ul>
        </details>
      </nav>
    </div>
  </header>

  <main id="main-content" tabindex="-1" class="outline-none">

    {# ══════ HERO — punchline, then problem quotes ══════ #}
    <section class="relative overflow-hidden" style="min-height: calc(100svh - 57px); display: flex; flex-direction: column; justify-content: center;" data-hero>
      <div
        class="absolute inset-0 pointer-events-none"
        style="background-image: linear-gradient(rgba(255,255,255,.03) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.03) 1px, transparent 1px); background-size: 48px 48px;"
        aria-hidden="true"
      ></div>


      <div class="relative max-w-4xl mx-auto px-6 py-20 w-full">
        <h1 class="font-extrabold leading-none tracking-tight text-white mb-4 whitespace-pre-line hyphens-manual" style="font-size: clamp(1.75rem, 7vw, 3.75rem);">{{ L.hero.headline }}</h1>
        <p class="text-slate-300 mb-12" style="font-size: clamp(1rem, 2vw, 1.25rem);">{{ L.hero.subtitle }}</p>

        <div class="mb-12" data-tabs="problem">
          <div
            class="flex flex-wrap gap-2 mb-6" role="tablist" aria-label="{{ L.problems.tabsAriaLabel }}" hidden
            data-active="bg-blue-600 text-white border-blue-600"
            data-inactive="bg-slate-800 text-slate-400 border-slate-700 hover:border-blue-500 hover:text-white"
          >
            {%- for key in L.personas %}
            {%- set p = L.problems[key] %}
            <button type="button" role="tab" id="problem-tab-{{ key }}" aria-controls="problem-panel-{{ key }}" aria-selected="false" tabindex="-1" data-persona="{{ key }}" class="flex items-center gap-2 px-4 py-2 rounded-full text-sm font-medium transition-all border">
              <span aria-hidden="true">{{ p.icon }}</span>
              {{ p.role }}
            </button>
            {%- endfor %}
          </div>

          <div class="flex flex-col gap-8">
            {%- for key in L.personas %}
            {%- set p = L.problems[key] %}
            <div id="problem-panel-{{ key }}" class="max-w-2xl" data-panel="{{ key }}">
              <h2 class="flex items-center gap-2 mb-3 text-sm font-medium text-slate-400" data-role-heading><span aria-hidden="true">{{ p.icon }}</span> {{ p.role }}</h2>
              <blockquote class="text-slate-200 leading-relaxed" style="font-size: clamp(1.1rem, 2.5vw, 1.375rem);">
                <span class="text-blue-400 text-3xl leading-none select-none mr-1" aria-hidden="true">„</span>
                {{ p.quote }}
                <span class="text-blue-400 text-3xl leading-none select-none mr-1" aria-hidden="true">“</span>
              </blockquote>
            </div>
            {%- endfor %}
          </div>

          {# Progress of the auto-advance; start.js shows it and swaps it for the spacer once locked. #}
          <div class="h-px bg-slate-700 rounded-full mt-8 overflow-hidden max-w-xs" aria-hidden="true" hidden data-progress>
            <div class="h-full bg-blue-500 rounded-full" style="width: 0%;"></div>
          </div>
          <div class="mt-8" data-progress-spacer></div>
        </div>

        <div class="text-slate-400 text-sm flex items-center gap-2">
          <span class="animate-bounce motion-reduce:animate-none inline-block" aria-hidden="true">↓</span>
          <span>{{ L.problems.scrollCue }}</span>
        </div>
      </div>
    </section>

    {# ══════ ECOSYSTEM CONCLUSION ══════ #}
    <section class="bg-slate-800 py-16 sm:py-20" aria-labelledby="ecosystem-heading">
      <div class="max-w-3xl mx-auto px-6">
        <h2 id="ecosystem-heading" class="font-extrabold tracking-tight text-white mb-6 whitespace-pre-line" style="font-size: clamp(1.75rem, 4.5vw, 3rem); line-height: 1.15;">{{ L.ecosystemProblem.headline }}</h2>
        <p class="text-slate-300 leading-relaxed mb-8" style="font-size: 1.0625rem;">{{ L.ecosystemProblem.body }}</p>
        <p class="text-slate-300 leading-relaxed" style="font-size: 1.0625rem;">{{ L.ecosystemProblem.bridge }}</p>
      </div>
    </section>

    {# ══════ SOLUTIONS — persona synced with the problem tabs ══════ #}
    <section class="bg-white py-16 sm:py-20" aria-labelledby="solutions-heading">
      <div class="max-w-4xl mx-auto px-6" data-tabs="solution">
        <h2 id="solutions-heading" class="sr-only">{{ L.solutions.intro }}</h2>

        <div
          class="flex flex-wrap justify-center gap-2 mb-10" role="tablist" aria-label="{{ L.solutions.tabsAriaLabel }}" hidden
          data-active="bg-blue-600 text-white border-blue-600 shadow-sm"
          data-inactive="bg-white text-slate-600 border-slate-200 hover:border-blue-300 hover:text-blue-700"
        >
          {%- for key in L.personas %}
          {%- set s = L.solutions[key] %}
          <button type="button" role="tab" id="solution-tab-{{ key }}" aria-controls="solution-panel-{{ key }}" aria-selected="false" tabindex="-1" data-persona="{{ key }}" class="flex items-center gap-2 px-5 py-2.5 rounded-full text-sm font-medium transition-all border">
            <span aria-hidden="true">{{ s.icon }}</span>
            {{ s.role }}
          </button>
          {%- endfor %}
        </div>

        <div class="flex flex-col gap-8">
          {%- for key in L.personas %}
          {%- set s = L.solutions[key] %}
          <div id="solution-panel-{{ key }}" class="w-full bg-slate-50 rounded-2xl border border-slate-200 p-8 sm:p-12 max-w-2xl mx-auto" data-panel="{{ key }}">
            <div class="flex items-center gap-4 mb-6">
              <span class="text-4xl" aria-hidden="true">{{ s.icon }}</span>
              <div>
                <p class="text-xs font-semibold text-blue-600 uppercase tracking-wider mb-1">{{ s.role }}</p>
                <h3 class="font-bold text-slate-900 leading-snug" style="font-size: clamp(1.125rem, 2.5vw, 1.5rem);">{{ s.headline }}</h3>
              </div>
            </div>

            <div class="space-y-4">
              {%- for paragraph in s.story | paragraphs %}
              <p class="text-slate-600 leading-relaxed" style="font-size: 1rem;">{{ paragraph }}</p>
              {%- endfor %}
            </div>

            <a href="{{ s.ctaHref | own }}" class="mt-8 inline-flex items-center gap-2 px-6 py-3 bg-blue-600 hover:bg-blue-700 text-white font-semibold rounded-xl transition-colors text-sm">{{ s.cta }} →</a>
            {%- if s.tryIt %}
            <p class="mt-4 text-sm text-slate-600 leading-relaxed">{{ s.tryIt.label }} <a href="{{ s.tryIt.href | own }}" class="font-semibold text-blue-700 underline underline-offset-2 hover:text-blue-800">{{ s.tryIt.linkText }}</a> — {{ s.tryIt.text }}</p>
            {%- endif %}
          </div>
          {%- endfor %}
        </div>
      </div>
    </section>

    {# ══════ PRINCIPLES ══════ #}
    {%- set P = L.principles %}
    <section id="{{ P.id }}" class="bg-slate-50 py-16 sm:py-20 scroll-mt-16" aria-labelledby="principles-heading">
      <div class="max-w-4xl mx-auto px-6">
        <h2 id="principles-heading" class="font-extrabold tracking-tight text-slate-900 mb-4" style="font-size: clamp(1.75rem, 4.5vw, 2.5rem); line-height: 1.15;">{{ P.heading }}</h2>
        <p class="text-slate-600 leading-relaxed max-w-2xl mb-10" style="font-size: 1.0625rem;">{{ P.intro }}</p>
        <ul class="grid grid-cols-1 sm:grid-cols-2 gap-6 list-none p-0 m-0" role="list">
          {%- for item in P.items %}
          <li class="bg-white rounded-2xl border border-slate-200 p-6">
            <h3 class="text-base font-semibold text-slate-900 mb-2">{{ item.title }}</h3>
            <p class="text-sm text-slate-600 leading-relaxed">{{ item.text }}</p>
          </li>
          {%- endfor %}
        </ul>
        <div class="mt-10 rounded-2xl border border-blue-200 bg-blue-50 p-6 sm:p-8 max-w-3xl">
          <h3 class="text-base font-semibold text-slate-900 mb-3">{{ P.privacy.title }}</h3>
          <div class="space-y-3">
            {%- for paragraph in P.privacy.text | paragraphs %}
            <p class="text-sm text-slate-700 leading-relaxed">{{ paragraph }}</p>
            {%- endfor %}
          </div>
        </div>
      </div>
    </section>

    {# ══════ WHY IT IS FREE — and a personal word ══════ #}
    {%- set W = L.whyFree %}
    <section id="{{ W.id }}" class="bg-white py-16 sm:py-20 scroll-mt-16" aria-labelledby="why-free-heading">
      <div class="max-w-3xl mx-auto px-6">
        <h2 id="why-free-heading" class="font-extrabold tracking-tight text-slate-900 mb-6" style="font-size: clamp(1.75rem, 4.5vw, 2.5rem); line-height: 1.15;">{{ W.heading }}</h2>
        <div class="space-y-4 mb-12">
          {%- for paragraph in W.text | paragraphs %}
          <p class="text-slate-700 leading-relaxed" style="font-size: 1.0625rem;">{{ paragraph }}</p>
          {%- endfor %}
        </div>
        <figure class="m-0 border-l-4 border-blue-500 pl-6">
          <h3 class="text-lg font-semibold text-slate-900 mb-4">{{ W.personal.heading }}</h3>
          <div class="space-y-4">
            {%- for paragraph in W.personal.text | paragraphs %}
            <p class="text-slate-700 leading-relaxed">{{ paragraph }}</p>
            {%- endfor %}
          </div>
          <figcaption class="mt-4 text-sm font-semibold text-slate-900">{{ W.personal.signature }}</figcaption>
        </figure>
      </div>
    </section>

    {# ══════ FOR SCEPTICS ══════ #}
    {%- set S = L.sceptics %}
    <section id="{{ S.id }}" class="bg-slate-800 py-16 sm:py-20 scroll-mt-16" aria-labelledby="sceptics-heading">
      <div class="max-w-3xl mx-auto px-6">
        <h2 id="sceptics-heading" class="font-extrabold tracking-tight text-white mb-6" style="font-size: clamp(1.75rem, 4.5vw, 2.5rem); line-height: 1.15;">{{ S.heading }}</h2>
        <div class="space-y-4 mb-8">
          {%- for paragraph in S.text | paragraphs %}
          <p class="text-slate-300 leading-relaxed" style="font-size: 1.0625rem;">{{ paragraph }}</p>
          {%- endfor %}
        </div>
        <ul class="flex flex-wrap gap-3 list-none p-0 m-0">
          {%- for link in S.links %}
          <li><a href="{{ link.href | own }}" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl border border-slate-600 text-white text-sm font-semibold hover:border-blue-400 hover:text-blue-200 transition-colors">{{ link.label }} →</a></li>
          {%- endfor %}
        </ul>
        <p class="mt-4 text-sm text-slate-400">{{ S.note }}</p>
      </div>
    </section>

    {# ══════ FINAL CTA ══════ #}
    <section class="py-16 sm:py-20 bg-blue-700 text-white" aria-labelledby="final-cta-heading">
      <div class="max-w-2xl mx-auto px-6 text-center">
        <h2 id="final-cta-heading" class="font-bold mb-4" style="font-size: clamp(1.5rem, 4vw, 2.25rem);">{{ L.cta.title }}</h2>
        <p class="text-blue-200 leading-relaxed mb-8">{{ L.cta.description }}</p>
        <div class="flex flex-wrap justify-center gap-3">
          <a href="{{ L.cta.primaryHref | own }}" class="inline-flex items-center gap-2 px-6 py-3 bg-white text-blue-700 font-semibold rounded-xl hover:bg-blue-50 transition-colors text-sm">{{ L.cta.primary }} →</a>
          <a href="{{ L.cta.secondaryHref | own }}" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-6 py-3 bg-blue-600 hover:bg-blue-500 text-white font-semibold rounded-xl transition-colors text-sm border border-blue-500">{{ L.cta.secondary }}</a>
        </div>
      </div>
    </section>
  </main>

  {# ══════ FOOTER ══════ #}
  <footer class="bg-slate-900 text-slate-400 py-10">
    <div class="max-w-5xl mx-auto px-6 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6">
      <div>
        <p class="flex items-end gap-[12px] leading-none text-white font-semibold tracking-tight text-sm mb-3"><img src="{{ '/brand/mark-plain.svg' | own }}" alt="" style="height: 1.25em; margin-bottom: -.12em;"><span>lernapps<span class="text-blue-400">.net</span></span></p>
        <p class="text-xs leading-relaxed max-w-xs">{{ L.footer.tagline }}</p>
        <p class="text-xs mt-2 text-slate-400">{{ L.footer.dsgvo }}</p>
      </div>
      <nav aria-label="{{ L.footer.navAriaLabel }}">
        <ul class="flex flex-wrap gap-4 list-none p-0 m-0">
          {%- for link in L.footer.links %}
          {%- set external = link.href.startsWith("http") %}
          <li><a href="{{ link.href | own }}" class="text-xs hover:text-white transition-colors"{% if external %} target="_blank" rel="noopener noreferrer"{% endif %}>{{ link.label }}</a></li>
          {%- endfor %}
        </ul>
      </nav>
    </div>
  </footer>
  </div>
</body>
</html>
