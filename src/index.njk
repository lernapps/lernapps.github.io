---
pagination:
  data: languages
  size: 1
  alias: l
permalink: "{{ l.root }}index.html"
---
{#-
  Home page of lernapps.net; CSS is generated by UnoCSS at build time (uno.config.js). One story, solution first:
  the promise, real apps from the catalog, what teachers and parents get, a solid foundation for makers, why another
  platform (it belongs to no company), how to join, and a short word from the founder. Details live on the features
  page (features.njk) and the about page (about.njk). Static HTML, no script of its own (only the usage counter
  of the site frame, once it is on).

  Texts: landing in src/_data/de.js and en.js (one page per language, see languages.js). No copy in this file.
-#}
{%- set L = l.t.landing -%}
<!doctype html>
<html lang="{{ l.code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="referrer" content="strict-origin-when-cross-origin">
  <title>{{ l.t.meta.title }}</title>
  <meta name="description" content="{{ l.t.meta.description }}">
  <link rel="canonical" href="https://lernapps.net/{{ l.root }}">
  {%- if site.preview %}
  <meta name="robots" content="noindex">
  {%- endif %}
  {% laHead page.url %}
  <link rel="stylesheet" href="{{ '/uno.css' | own }}">
</head>
<body>
  <div class="min-h-screen bg-slate-900 text-white" style="font-family: system-ui, -apple-system, 'Segoe UI', sans-serif;">
  {% laHeader page.url %}

  <main id="main-content" tabindex="-1" class="outline-none">

    {# ══════ 1 HERO — the promise ══════ #}
    {%- set H = L.hero %}
    <section class="relative overflow-hidden">
      <div class="absolute inset-0 pointer-events-none" style="background-image: linear-gradient(rgba(255,255,255,.03) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.03) 1px, transparent 1px); background-size: 48px 48px;" aria-hidden="true"></div>
      <div class="relative max-w-4xl mx-auto px-6 py-24 sm:py-32 w-full">
        <h1 class="font-extrabold leading-none tracking-tight text-white mb-6" style="font-size: clamp(2.25rem, 8vw, 4.5rem);">{{ H.headline }}</h1>
        <p class="text-slate-300 mb-8 max-w-2xl" style="font-size: clamp(1.125rem, 2.2vw, 1.375rem); line-height: 1.5;">{{ H.subtitle }}</p>
        <ul class="flex flex-wrap gap-2 list-none p-0 m-0 mb-10">
          {%- for b in H.badges %}
          <li class="flex items-center gap-2 px-4 py-2 rounded-full text-sm font-medium bg-slate-800 text-slate-200 border border-slate-700"><span class="text-blue-400" aria-hidden="true">✓</span>{{ b }}</li>
          {%- endfor %}
        </ul>
        <div class="flex flex-wrap gap-3">
          <a href="{{ H.primaryHref | own }}" class="inline-flex items-center gap-2 px-7 py-3.5 bg-blue-600 hover:bg-blue-700 text-white font-semibold rounded-xl transition-colors">{{ H.primary }} →</a>
          <a href="{{ H.secondaryHref }}" class="inline-flex items-center gap-2 px-7 py-3.5 rounded-xl border border-slate-600 text-white font-semibold hover:border-blue-400 hover:text-blue-200 transition-colors">{{ H.secondary }}</a>
        </div>
      </div>
    </section>

    {# ══════ 2 SHOWCASE — real apps, real makers ══════ #}
    {%- set S = L.showcase %}
    <section id="beispiele" class="bg-white py-16 sm:py-20" aria-labelledby="showcase-heading">
      <div class="max-w-5xl mx-auto px-6">
        <h2 id="showcase-heading" class="font-extrabold tracking-tight text-slate-900 mb-3" style="font-size: clamp(1.75rem, 4.5vw, 2.5rem); line-height: 1.15;">{{ S.heading }}</h2>
        <p class="text-slate-600 leading-relaxed max-w-2xl mb-10" style="font-size: 1.0625rem;">{{ S.intro }}</p>
        <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 list-none p-0 m-0">
          {%- for a in S.apps %}
          <li>
            <a href="{{ a.href | own }}" class="flex flex-col h-full bg-slate-50 rounded-2xl border border-slate-200 p-6 hover:border-blue-300 transition-colors">
              <span class="text-3xl mb-4" aria-hidden="true">{{ a.icon }}</span>
              <span class="text-xs font-semibold text-blue-600 uppercase tracking-wider mb-1">{{ a.meta }}</span>
              <span class="font-bold text-slate-900 text-lg mb-2">{{ a.title }}</span>
              <span class="text-sm text-slate-600 leading-relaxed">{{ a.text }}</span>
            </a>
          </li>
          {%- endfor %}
        </ul>
        <div class="mt-8 flex flex-wrap items-baseline gap-x-6 gap-y-2">
          <a href="{{ S.allHref | own }}" class="inline-flex items-center gap-2 font-semibold text-blue-700 hover:text-blue-800">{{ S.all }} →</a>
          <p class="text-sm text-slate-500">{{ S.early }}</p>
        </div>
        <p class="mt-6 max-w-3xl text-sm text-slate-600 leading-relaxed">{{ S.lasting }} {{ S.honest }}</p>
      </div>
    </section>

    {# ══════ 3 FOR YOU — teacher and parent ══════ #}
    {%- set F = L.forYou %}
    <section id="fuer-dich" class="bg-slate-50 py-16 sm:py-20" aria-labelledby="foryou-heading">
      <div class="max-w-5xl mx-auto px-6">
        <h2 id="foryou-heading" class="font-extrabold tracking-tight text-slate-900 mb-10" style="font-size: clamp(1.75rem, 4.5vw, 2.5rem); line-height: 1.15;">{{ F.heading }}</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {%- for s in F.items %}
          <div class="bg-white rounded-2xl border border-slate-200 p-8">
            <div class="flex items-center gap-4 mb-5">
              <span class="text-4xl" aria-hidden="true">{{ s.icon }}</span>
              <div>
                <p class="text-xs font-semibold text-blue-600 uppercase tracking-wider mb-1">{{ s.role }}</p>
                <h3 class="font-bold text-slate-900 leading-snug" style="font-size: clamp(1.125rem, 2.5vw, 1.5rem);">{{ s.headline }}</h3>
              </div>
            </div>
            <div class="space-y-3">
              {%- for p in s.text | paragraphs %}
              <p class="text-slate-600 leading-relaxed">{{ p }}</p>
              {%- endfor %}
            </div>
            <a href="{{ s.ctaHref | own }}" class="mt-6 inline-flex items-center gap-2 px-6 py-3 bg-blue-600 hover:bg-blue-700 text-white font-semibold rounded-xl transition-colors text-sm">{{ s.cta }} →</a>
          </div>
          {%- endfor %}
        </div>
        {#- Privacy is a feature, not small print: teachers pass the privacy notice on to their school. #}
        <div class="mt-6 rounded-2xl border border-blue-200 bg-blue-50 p-6 sm:p-8">
          <h3 class="flex items-center gap-2 text-base font-semibold text-slate-900 mb-2"><span aria-hidden="true">🔒</span>{{ F.privacy.title }}</h3>
          <p class="text-slate-700 leading-relaxed">{{ F.privacy.text }} <a href="{{ F.privacy.href | own }}" class="font-semibold text-blue-700 underline underline-offset-2 hover:text-blue-800 whitespace-nowrap">{{ F.privacy.link }} →</a></p>
        </div>
        {#- The break: who does not build apps can stop here and go to the catalog. #}
        <p class="mt-10 text-slate-600 leading-relaxed">{{ F.next }} <a href="{{ F.nextHref | own }}" class="font-semibold text-blue-700 underline underline-offset-2 hover:text-blue-800 whitespace-nowrap">{{ F.nextLink }} →</a></p>
      </div>
    </section>

    {# ══════ 4 WHAT IS DIFFERENT — passion meets a frame ══════ #}
    {%- set D = L.different %}
    <section class="bg-slate-800 py-16 sm:py-20" aria-labelledby="different-heading">
      <div class="max-w-4xl mx-auto px-6">
        <h2 id="different-heading" class="font-extrabold tracking-tight text-white mb-6" style="font-size: clamp(1.75rem, 4.5vw, 3rem); line-height: 1.15;">{{ D.heading }}</h2>
        <p class="text-slate-300 leading-relaxed max-w-3xl mb-10" style="font-size: 1.0625rem;">{{ D.intro }}</p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-10">
          {%- for col in [D.makers, D.platform] %}
          <div class="rounded-2xl border border-slate-700 bg-slate-900 p-6">
            <h3 class="text-base font-semibold text-blue-300 mb-4">{{ col.title }}</h3>
            <ul class="space-y-3 list-none p-0 m-0">
              {%- for it in col.items %}
              <li class="flex gap-3 text-slate-200 leading-relaxed"><span class="text-blue-400" aria-hidden="true">●</span><span>{{ it }}</span></li>
              {%- endfor %}
            </ul>
          </div>
          {%- endfor %}
        </div>
        <p class="text-white font-semibold mb-6" style="font-size: 1.125rem;">{{ D.result }}</p>
        <a href="{{ D.linkHref | own }}" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl border border-slate-600 text-white text-sm font-semibold hover:border-blue-400 hover:text-blue-200 transition-colors">{{ D.link }} →</a>
      </div>
    </section>

    {# ══════ 5 WHY ANOTHER PLATFORM — objection, answer, principles ══════ #}
    {%- set P = L.platform %}
    <section id="plattform" class="bg-white py-16 sm:py-24" aria-labelledby="platform-heading">
      <div class="max-w-5xl mx-auto px-6 grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16">
        <div>
          <p class="text-slate-500 mb-5" style="font-size: clamp(1.125rem, 2.5vw, 1.5rem); line-height: 1.35;"><span class="text-blue-500" aria-hidden="true">„</span>{{ P.objection }}<span class="text-blue-500" aria-hidden="true">“</span></p>
          <h2 id="platform-heading" class="font-extrabold tracking-tight text-slate-900 mb-6" style="font-size: clamp(1.75rem, 4.5vw, 2.75rem); line-height: 1.12;">{{ P.heading }}</h2>
          <p class="text-slate-700 leading-relaxed" style="font-size: 1.0625rem;">{{ P.intro }}</p>
        </div>
        <div class="lg:pt-2">
          <ol class="space-y-7 list-none p-0 m-0">
            {%- for pt in P.points %}
            <li class="flex gap-4">
              <span class="mt-0.5 shrink-0 w-9 h-9 rounded-full bg-blue-600 text-white flex items-center justify-center text-sm font-bold" aria-hidden="true">{{ loop.index }}</span>
              <div><h3 class="font-semibold text-slate-900 mb-1">{{ pt.title }}</h3><p class="text-slate-600 leading-relaxed">{{ pt.text }}{% if pt.link %} <a href="{{ pt.link.href | own }}" class="font-semibold text-blue-700 underline underline-offset-2 hover:text-blue-800 whitespace-nowrap">{{ pt.link.label }} →</a>{% endif %}</p></div>
            </li>
            {%- endfor %}
          </ol>
          <ul class="flex flex-wrap gap-3 list-none p-0 m-0 mt-9">
            {%- for link in P.links %}
            <li><a href="{{ link.href | own }}" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl border border-slate-300 text-slate-800 text-sm font-semibold hover:border-blue-400 hover:text-blue-700 transition-colors">{{ link.label }} →</a></li>
            {%- endfor %}
          </ul>
        </div>
      </div>
    </section>

    {# ══════ 6 JOIN ══════ #}
    {%- set J = L.join %}
    <section id="{{ J.id }}" class="bg-slate-50 py-16 sm:py-20 scroll-mt-16" aria-labelledby="join-heading">
      <div class="max-w-3xl mx-auto px-6">
        <p class="text-4xl mb-4" aria-hidden="true">🔧</p>
        <h2 id="join-heading" class="font-extrabold tracking-tight text-slate-900 mb-6" style="font-size: clamp(1.75rem, 4.5vw, 2.5rem); line-height: 1.15;">{{ J.heading }}</h2>
        <div class="space-y-4 mb-8">
          {%- for p in J.text | paragraphs %}
          <p class="text-slate-700 leading-relaxed" style="font-size: 1.0625rem;">{{ p }}</p>
          {%- endfor %}
        </div>
        <a href="{{ J.ctaHref | own }}" class="inline-flex items-center gap-2 px-6 py-3 bg-blue-600 hover:bg-blue-700 text-white font-semibold rounded-xl transition-colors text-sm">{{ J.cta }} →</a>
      </div>
    </section>

    {# ══════ 7 FOUNDER ══════ #}
    {%- set W = L.founder %}
    <section class="bg-white py-16 sm:py-20" aria-labelledby="founder-heading">
      <div class="max-w-3xl mx-auto px-6">
        <figure class="m-0 border-l-4 border-blue-500 pl-6 sm:pl-8">
          <h2 id="founder-heading" class="font-extrabold tracking-tight text-slate-900 mb-6" style="font-size: clamp(1.5rem, 3.5vw, 2.125rem); line-height: 1.2;">{{ W.heading }}</h2>
          <div class="space-y-4">
            {%- for p in W.text | paragraphs %}
            <p class="text-slate-700 leading-relaxed" style="font-size: 1.0625rem;">{{ p }}</p>
            {%- endfor %}
          </div>
          <figcaption class="mt-6"><span class="block font-semibold text-slate-900">{{ W.signature }}</span><span class="text-sm text-slate-500">{{ W.role }}</span></figcaption>
        </figure>
        <a href="{{ W.linkHref | own }}" class="mt-8 inline-flex items-center gap-2 font-semibold text-blue-700 hover:text-blue-800">{{ W.link }} →</a>
      </div>
    </section>

    {# ══════ FINAL CTA ══════ #}
    <section class="py-16 sm:py-20 bg-blue-700 text-white" aria-labelledby="final-cta-heading">
      <div class="max-w-2xl mx-auto px-6 text-center">
        <h2 id="final-cta-heading" class="font-bold mb-4" style="font-size: clamp(1.5rem, 4vw, 2.25rem);">{{ L.cta.title }}</h2>
        <p class="text-blue-200 leading-relaxed mb-8">{{ L.cta.description }}</p>
        <div class="flex flex-wrap justify-center gap-3">
          <a href="{{ L.cta.primaryHref | own }}" class="inline-flex items-center gap-2 px-6 py-3 bg-white text-blue-700 font-semibold rounded-xl hover:bg-blue-50 transition-colors text-sm">{{ L.cta.primary }} →</a>
          <a href="{{ L.cta.secondaryHref | own }}" class="inline-flex items-center gap-2 px-6 py-3 bg-blue-600 hover:bg-blue-500 text-white font-semibold rounded-xl transition-colors text-sm border border-blue-500">{{ L.cta.secondary }}</a>
        </div>
      </div>
    </section>
  </main>

  {% laFooter page.url %}
  </div>
</body>
</html>
