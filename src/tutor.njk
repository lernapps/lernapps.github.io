---
pagination:
  data: languages
  size: 1
  alias: l
permalink: "{{ l.root }}tutor/index.html"
---
{#-
  "Tutor" in the header: the learning companion of the explainer apps, parallel to /tooling/ (AI for building). It
  describes a feature of the explainer, not a service of the platform: there is no AI on lernapps.net. The learning
  content is readable and referable, so the learner's own assistant can accompany, guide and support them, and
  lernapps.net learns nothing about it. Sections: the tutor with an example conversation, how it works, the rules,
  what the tutor gets (transparency), privacy, limits. The home page links its anchors (de: #tutor, #ablauf, #regeln,
  #transparenz, #datenschutz, #grenzen; en: #tutor, #how, #rules, #transparency, #privacy, #limits). Texts: tutor in
  src/_data/de.js, en.js. The partials ki-dialog.njk and ki-flow.njk read K, which is the same object as T.
-#}
{%- set T = l.t.tutor -%}
{%- set K = T -%}
<!doctype html>
<html lang="{{ l.code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="referrer" content="strict-origin-when-cross-origin">
  <title>{{ T.meta.title }}</title>
  <meta name="description" content="{{ T.meta.description }}">
  <link rel="canonical" href="https://lernapps.net/{{ l.root }}tutor/">
  {%- if site.preview %}
  <meta name="robots" content="noindex">
  {%- endif %}
  {% laHead page.url %}
  {%- include "counter.njk" %}
  <link rel="stylesheet" href="{{ '/uno.css' | own }}">
</head>
<body>
  <div class="min-h-screen bg-slate-900 text-white" style="font-family: system-ui, -apple-system, 'Segoe UI', sans-serif;">
  {% laHeader page.url %}

  <main id="main-content" tabindex="-1" class="outline-none">

    {# ══════ HERO ══════ #}
    <section class="relative overflow-hidden">
      <div class="absolute inset-0 pointer-events-none" style="background-image: linear-gradient(rgba(255,255,255,.03) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.03) 1px, transparent 1px); background-size: 48px 48px;" aria-hidden="true"></div>
      <div class="relative max-w-4xl mx-auto px-6 py-20 sm:py-24 w-full">
        <h1 class="font-extrabold leading-none tracking-tight text-white mb-6" style="font-size: clamp(2rem, 6vw, 3.5rem);">{{ T.hero.headline }}</h1>
        <p class="text-slate-300 mb-8 max-w-2xl" style="font-size: clamp(1.0625rem, 2vw, 1.25rem); line-height: 1.5;">{{ T.hero.subtitle }}</p>
        <ul class="flex flex-wrap gap-2 list-none p-0 m-0">
          {%- for j in T.hero.jump %}
          <li><a href="{{ j.href }}" class="inline-flex items-center gap-2 px-4 py-2 rounded-full text-sm font-medium bg-slate-800 text-slate-200 border border-slate-700 hover:border-blue-500 hover:text-white transition-colors">{{ j.label }} ↓</a></li>
          {%- endfor %}
        </ul>
      </div>
    </section>

    {# ══════ THE TUTOR — the value, with an example conversation ══════ #}
    {%- set A = T.about %}
    <section id="{{ A.id }}" class="bg-white py-16 sm:py-20 scroll-mt-16" aria-labelledby="about-heading">
      <div class="max-w-4xl mx-auto px-6">
        <h2 id="about-heading" class="font-extrabold tracking-tight text-slate-900 mb-6" style="font-size: clamp(1.75rem, 4.5vw, 2.5rem); line-height: 1.15;">{{ A.heading }}</h2>
        <div class="space-y-4 max-w-3xl mb-10">
          {%- for p in A.text | paragraphs %}
          <p class="text-slate-700 leading-relaxed" style="font-size: 1.0625rem;">{{ p }}</p>
          {%- endfor %}
        </div>
        {%- include "ki-dialog.njk" %}
        <a href="{{ A.ctaHref | own }}" class="mt-8 inline-flex items-center gap-2 px-6 py-3 bg-blue-600 hover:bg-blue-700 text-white font-semibold rounded-xl transition-colors">{{ A.cta }} →</a>
      </div>
    </section>

    {# ══════ HOW IT WORKS ══════ #}
    {%- set S = T.process %}
    <section id="{{ S.id }}" class="bg-slate-50 py-16 sm:py-20 scroll-mt-16" aria-labelledby="flow-heading">
      <div class="max-w-5xl mx-auto px-6">
        <h2 id="flow-heading" class="font-extrabold tracking-tight text-slate-900 mb-4" style="font-size: clamp(1.75rem, 4.5vw, 2.5rem); line-height: 1.15;">{{ S.heading }}</h2>
        <p class="text-slate-700 leading-relaxed max-w-3xl mb-10" style="font-size: 1.0625rem;">{{ S.intro }}</p>
        <ol class="space-y-4 list-none p-0 m-0 mb-10 max-w-3xl">
          {%- for st in S.steps %}
          <li class="flex gap-4 rounded-2xl border border-slate-200 bg-white p-5 sm:p-6">
            <span class="mt-0.5 shrink-0 w-9 h-9 rounded-full bg-blue-600 text-white flex items-center justify-center text-sm font-bold" aria-hidden="true">{{ loop.index }}</span>
            <div><h3 class="font-semibold text-slate-900 mb-1">{{ st.title }}</h3><p class="text-slate-600 leading-relaxed">{{ st.text }}</p></div>
          </li>
          {%- endfor %}
        </ol>
      </div>
    </section>

    {# ══════ THE TUTOR'S RULES ══════ #}
    {%- set R = T.rules %}
    <section id="{{ R.id }}" class="bg-slate-800 py-16 sm:py-20 scroll-mt-16" aria-labelledby="rules-heading">
      <div class="max-w-5xl mx-auto px-6">
        <h2 id="rules-heading" class="font-extrabold tracking-tight text-white mb-4" style="font-size: clamp(1.75rem, 4.5vw, 3rem); line-height: 1.15;">{{ R.heading }}</h2>
        <p class="text-slate-300 leading-relaxed max-w-3xl mb-10" style="font-size: 1.0625rem;">{{ R.intro }}</p>
        <ul class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5 list-none p-0 m-0">
          {%- for it in R.items %}
          <li class="rounded-2xl border border-slate-700 bg-slate-900 p-6">
            <span class="text-2xl" aria-hidden="true">{{ it.icon }}</span>
            <h3 class="text-base font-semibold text-white mt-3 mb-2">{{ it.title }}</h3>
            <p class="text-sm text-slate-300 leading-relaxed">{{ it.text }}</p>
          </li>
          {%- endfor %}
        </ul>
      </div>
    </section>

    {# ══════ TRANSPARENCY AND PRIVACY ══════ #}
    {%- set X = T.transparency %}
    {%- set P = T.privacy %}
    <section class="bg-white py-16 sm:py-20" aria-labelledby="transparency-heading">
      <div class="max-w-4xl mx-auto px-6 space-y-12">
        <div id="{{ X.id }}" class="scroll-mt-16">
          <h2 id="transparency-heading" class="font-extrabold tracking-tight text-slate-900 mb-4" style="font-size: clamp(1.5rem, 3.5vw, 2.125rem); line-height: 1.2;">{{ X.heading }}</h2>
          <p class="text-slate-700 leading-relaxed max-w-3xl" style="font-size: 1.0625rem;">{{ X.text }}</p>
          <p class="mt-4"><a href="{{ X.href | own }}" class="font-semibold text-blue-700 underline underline-offset-2 hover:text-blue-800">{{ X.link }} →</a></p>
        </div>
        <div id="{{ P.id }}" class="scroll-mt-16 space-y-6">
          {%- include "ki-flow.njk" %}
          <div class="rounded-2xl border border-blue-200 bg-blue-50 p-6 sm:p-8">
          <h2 class="flex items-center gap-2 font-extrabold tracking-tight text-slate-900 mb-1" style="font-size: clamp(1.5rem, 3.5vw, 2.125rem); line-height: 1.2;"><span aria-hidden="true">🔒</span>{{ P.heading }}</h2>
          <h3 class="text-base font-semibold text-blue-800 mb-4">{{ P.title }}</h3>
          <div class="space-y-3">
            {%- for p in P.text | paragraphs %}
            <p class="text-slate-700 leading-relaxed">{{ p }}</p>
            {%- endfor %}
          </div>
          <p class="mt-4"><a href="{{ P.href | own }}" class="font-semibold text-blue-700 underline underline-offset-2 hover:text-blue-800 whitespace-nowrap">{{ P.link }} →</a></p>
          </div>
        </div>
      </div>
    </section>

    {# ══════ LIMITS ══════ #}
    {%- set M = T.limits %}
    <section id="{{ M.id }}" class="bg-slate-50 py-16 sm:py-20 scroll-mt-16" aria-labelledby="limits-heading">
      <div class="max-w-4xl mx-auto px-6">
        <h2 id="limits-heading" class="font-extrabold tracking-tight text-slate-900 mb-8" style="font-size: clamp(1.75rem, 4.5vw, 2.5rem); line-height: 1.15;">{{ M.heading }}</h2>
        <ul class="grid grid-cols-1 sm:grid-cols-2 gap-x-10 gap-y-6 list-none p-0 m-0">
          {%- for it in M.items %}
          <li class="flex gap-3">
            <span class="text-blue-600 font-bold mt-0.5" aria-hidden="true">●</span>
            <div><h3 class="font-semibold text-slate-900 mb-1">{{ it.title }}</h3><p class="text-slate-600 leading-relaxed">{{ it.text }}</p></div>
          </li>
          {%- endfor %}
        </ul>
      </div>
    </section>

    {# ══════ FINAL CTA ══════ #}
    <section class="py-16 sm:py-20 bg-blue-700 text-white" aria-labelledby="tutor-cta-heading">
      <div class="max-w-2xl mx-auto px-6 text-center">
        <h2 id="tutor-cta-heading" class="font-bold mb-4" style="font-size: clamp(1.5rem, 4vw, 2.25rem);">{{ T.cta.title }}</h2>
        <p class="text-blue-200 leading-relaxed mb-8">{{ T.cta.description }}</p>
        <div class="flex flex-wrap justify-center gap-3">
          <a href="{{ T.cta.primaryHref | own }}" class="inline-flex items-center gap-2 px-6 py-3 bg-white text-blue-700 font-semibold rounded-xl hover:bg-blue-50 transition-colors text-sm">{{ T.cta.primary }} →</a>
          <a href="{{ T.cta.secondaryHref | own }}" class="inline-flex items-center gap-2 px-6 py-3 bg-blue-600 hover:bg-blue-500 text-white font-semibold rounded-xl transition-colors text-sm border border-blue-500">{{ T.cta.secondary }}</a>
        </div>
      </div>
    </section>
  </main>

  {% laFooter page.url %}
  </div>
</body>
</html>
